# Secrets cho Edge Functions  ->  supabase secrets set --env-file backend/.env
# (SUPABASE_URL và SUPABASE_SERVICE_ROLE_KEY được Supabase tự cấp sẵn trong môi trường function)

# Tạo cặp khóa VAPID:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Chuỗi bí mật dài ngẫu nhiên để pg_cron gọi cron-reminders (header x-cron-secret)
CRON_SECRET=
